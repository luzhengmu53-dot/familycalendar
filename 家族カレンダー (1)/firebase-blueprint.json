{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile and active family linkage.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Google account email" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoUrl": { "type": "string", "description": "Optional Google profile photo URL" },
        "colorHex": { "type": "string", "description": "Shared account hex color across all calendars" },
        "avatarSymbol": { "type": "string", "description": "Shared account symbol across all calendars" },
        "avatarImageBase64": { "type": "string", "description": "Shared account avatar image across all calendars" },
        "activeFamilyId": { "type": "string", "description": "Currently active family group ID" },
        "pendingFamilyId": { "type": "string", "description": "Family ID awaiting owner approval" },
        "pendingFamilyName": { "type": "string", "description": "Family name awaiting owner approval" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "FamilyGroup": {
      "title": "FamilyGroup",
      "description": "Personal or shared family calendar database container.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Calendar display name" },
        "iconSymbol": { "type": "string", "description": "Calendar icon symbol" },
        "colorHex": { "type": "string", "description": "Calendar icon color hex" },
        "iconImageBase64": { "type": "string", "description": "Optional custom calendar icon image" },
        "calendarType": { "type": "string", "enum": ["personal", "shared"], "description": "Whether the calendar is personal or shared" },
        "ownerUid": { "type": "string", "description": "Creator UID" },
        "ownerEmail": { "type": "string", "description": "Creator email for optional mailto notification" },
        "inviteCode": { "type": "string", "description": "Alphanumeric invite code embedded in QR" },
        "memberUids": { "type": "array", "description": "Approved member UIDs (max 20)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["name", "ownerUid", "ownerEmail", "inviteCode", "memberUids", "createdAt", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Member profile within a family including customizable icon color and symbol.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Member Firebase Auth UID" },
        "familyId": { "type": "string", "description": "Parent family group ID" },
        "displayName": { "type": "string", "description": "Customizable family display name" },
        "email": { "type": "string", "description": "Member Google email" },
        "colorHex": { "type": "string", "description": "Hex color string (#RRGGBB) for calendar badges" },
        "avatarSymbol": { "type": "string", "description": "Emoji or initial shown inside avatar badge" },
        "avatarImageBase64": { "type": "string", "description": "Optional uploaded avatar image" },
        "role": { "type": "string", "enum": ["owner", "member"], "description": "Member role" },
        "memberUids": { "type": "array", "description": "Denormalized family member UIDs for rule checks" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["uid", "familyId", "displayName", "email", "colorHex", "avatarSymbol", "role", "memberUids", "createdAt", "updatedAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Pending QR code join request awaiting family owner approval.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string", "description": "Target family group ID" },
        "familyOwnerUid": { "type": "string", "description": "Target family owner UID" },
        "requesterUid": { "type": "string", "description": "Applicant UID" },
        "requesterName": { "type": "string", "description": "Applicant display name" },
        "requesterEmail": { "type": "string", "description": "Applicant Google email" },
        "inviteCode": { "type": "string", "description": "Invite code scanned from QR" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["familyId", "familyOwnerUid", "requesterUid", "requesterName", "requesterEmail", "inviteCode", "status", "createdAt", "updatedAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Shared or personal calendar schedule event.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string", "description": "Parent family group ID" },
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event memo or notes" },
        "location": { "type": "string", "description": "Event location" },
        "dateKey": { "type": "string", "description": "Date in YYYY-MM-DD format" },
        "startMinutes": { "type": "integer", "description": "Start time in minutes since midnight (0-1439)" },
        "endMinutes": { "type": "integer", "description": "End time in minutes since midnight (0-1439)" },
        "isAllDay": { "type": "boolean", "description": "Whether event lasts all day" },
        "assignedMemberUid": { "type": "string", "description": "Assigned member UID or ALL" },
        "reminderMinutesBefore": { "type": "integer", "description": "Reminder minutes before event (-1 for disabled)" },
        "createdByUid": { "type": "string", "description": "Author UID" },
        "memberUids": { "type": "array", "description": "Denormalized family member UIDs for rule checks" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["familyId", "title", "description", "location", "dateKey", "startMinutes", "endMinutes", "isAllDay", "assignedMemberUid", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and active family state"
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/FamilyGroup" },
      "description": "Family calendar group metadata"
    },
    "/families/{familyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Family member profiles and custom icon colors"
    },
    "/families/{familyId}/joinRequests/{requesterUid}": {
      "schema": { "$ref": "#/entities/JoinRequest" },
      "description": "QR join requests awaiting owner approval"
    },
    "/families/{familyId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Shared family calendar events"
    }
  }
}
