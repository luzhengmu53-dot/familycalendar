rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function familyExists(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId));
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isFamilyMember(familyId) {
      return familyExists(familyId) && request.auth.uid in familyDoc(familyId).memberUids;
    }

    function isFamilyOwner(familyId) {
      return familyExists(familyId) && familyDoc(familyId).ownerUid == request.auth.uid;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('colorHex' in data) || (data.colorHex is string && data.colorHex.matches('^#[0-9A-Fa-f]{6}$'))) &&
             (!('avatarSymbol' in data) || (data.avatarSymbol is string && data.avatarSymbol.size() >= 1 && data.avatarSymbol.size() <= 8)) &&
             (!('avatarImageBase64' in data) || (data.avatarImageBase64 is string && data.avatarImageBase64.size() <= 65000)) &&
             (!('activeFamilyId' in data) || (data.activeFamilyId is string && data.activeFamilyId.size() <= 128)) &&
             (!('pendingFamilyId' in data) || (data.pendingFamilyId is string && data.pendingFamilyId.size() <= 128)) &&
             (!('pendingFamilyName' in data) || (data.pendingFamilyName is string && data.pendingFamilyName.size() <= 60)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFamilyGroup(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             (!('iconSymbol' in data) || (data.iconSymbol is string && data.iconSymbol.size() >= 1 && data.iconSymbol.size() <= 8)) &&
             (!('colorHex' in data) || (data.colorHex is string && data.colorHex.matches('^#[0-9A-Fa-f]{6}$'))) &&
             (!('iconImageBase64' in data) || (data.iconImageBase64 is string && data.iconImageBase64.size() <= 65000)) &&
             (!('calendarType' in data) || data.calendarType in ['personal', 'shared']) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() <= 120 &&
             data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 16 &&
             data.inviteCode.matches('^[A-Z0-9]+$') &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 20 &&
             data.memberUids[0] is string &&
             data.ownerUid in data.memberUids &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFamilyMember(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.familyId is string && isValidId(data.familyId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.email is string && data.email.size() <= 120 &&
             data.colorHex is string && data.colorHex.matches('^#[0-9A-Fa-f]{6}$') &&
             data.avatarSymbol is string && data.avatarSymbol.size() >= 1 && data.avatarSymbol.size() <= 8 &&
             (!('avatarImageBase64' in data) || (data.avatarImageBase64 is string && data.avatarImageBase64.size() <= 65000)) &&
             data.role in ['owner', 'member'] &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 20 &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidJoinRequest(data) {
      return data.familyId is string && isValidId(data.familyId) &&
             data.familyOwnerUid is string && data.familyOwnerUid.size() >= 1 && data.familyOwnerUid.size() <= 128 &&
             data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128 &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 50 &&
             data.requesterEmail is string && data.requesterEmail.size() <= 120 &&
             data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 16 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCalendarEvent(data) {
      return data.familyId is string && isValidId(data.familyId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.location is string && data.location.size() <= 120 &&
             data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startMinutes is int && data.startMinutes >= 0 && data.startMinutes <= 1439 &&
             data.endMinutes is int && data.endMinutes >= 0 && data.endMinutes <= 1439 &&
             data.endMinutes >= data.startMinutes &&
             data.isAllDay is bool &&
             data.assignedMemberUid is string && data.assignedMemberUid.size() >= 1 && data.assignedMemberUid.size() <= 128 &&
             (!('reminderMinutesBefore' in data) || (data.reminderMinutesBefore is int && data.reminderMinutesBefore >= -1 && data.reminderMinutesBefore <= 1440)) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 20 &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection Rules ---

    // 1. User Profiles (PII isolated to owner only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'colorHex', 'avatarSymbol', 'avatarImageBase64', 'activeFamilyId', 'pendingFamilyId', 'pendingFamilyName', 'createdAt', 'updatedAt']) &&
                       incoming().uid == request.auth.uid &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoUrl', 'colorHex', 'avatarSymbol', 'avatarImageBase64', 'activeFamilyId', 'pendingFamilyId', 'pendingFamilyName', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Family Groups
    match /families/{familyId} {
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;
      allow get: if isSignedIn() && isValidId(familyId) &&
                    (request.auth.uid in existing().memberUids || existing().ownerUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(familyId) &&
                       incoming().keys().hasAll(['name', 'ownerUid', 'ownerEmail', 'inviteCode', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'iconSymbol', 'colorHex', 'iconImageBase64', 'calendarType', 'ownerUid', 'ownerEmail', 'inviteCode', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       isValidFamilyGroup(incoming());

      allow update: if isSignedIn() &&
                       isValidId(familyId) &&
                       isValidFamilyGroup(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().ownerUid == request.auth.uid &&
                          incoming().ownerUid == existing().ownerUid &&
                          incoming().ownerEmail == existing().ownerEmail &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'iconSymbol', 'colorHex', 'iconImageBase64', 'calendarType', 'inviteCode', 'memberUids', 'updatedAt'])) ||
                         (request.auth.uid in existing().memberUids &&
                          existing().memberUids.size() > 1 &&
                          !(request.auth.uid in incoming().memberUids) &&
                          existing().memberUids.hasAll(incoming().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                          (
                            (request.auth.uid != existing().ownerUid &&
                             incoming().ownerUid == existing().ownerUid &&
                             incoming().ownerEmail == existing().ownerEmail &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                            (request.auth.uid == existing().ownerUid &&
                             incoming().ownerUid in incoming().memberUids &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'ownerEmail', 'memberUids', 'updatedAt']))
                          ))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(familyId) &&
                       existing().ownerUid == request.auth.uid &&
                       existing().memberUids.size() <= 1;

      // 3. Family Members (with customizable color & symbol)
      match /members/{memberId} {
        allow list: if isSignedIn() && request.auth.uid in existing().memberUids;
        allow get: if isSignedIn() && isValidId(familyId) && isValidId(memberId) &&
                      (request.auth.uid == memberId || request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(memberId) &&
                         incoming().keys().hasAll(['uid', 'familyId', 'displayName', 'email', 'colorHex', 'avatarSymbol', 'role', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['uid', 'familyId', 'displayName', 'email', 'colorHex', 'avatarSymbol', 'avatarImageBase64', 'role', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().uid == memberId &&
                         incoming().familyId == familyId &&
                         isValidFamilyMember(incoming()) &&
                         (
                           (request.auth.uid == memberId && incoming().role == 'owner' &&
                            getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid) ||
                           (isFamilyOwner(familyId) && incoming().role == 'member')
                         );

        allow update: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(memberId) &&
                         isValidFamilyMember(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().familyId == existing().familyId &&
                         incoming().email == existing().email &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (request.auth.uid == memberId &&
                            incoming().role == existing().role &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'colorHex', 'avatarSymbol', 'avatarImageBase64', 'updatedAt'])) ||
                           (isFamilyOwner(familyId) &&
                            incoming().role == existing().role &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                           (isFamilyMember(familyId) &&
                            request.auth.uid != memberId &&
                            !(request.auth.uid in incoming().memberUids) &&
                            existing().memberUids.hasAll(incoming().memberUids) &&
                            incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                            (
                              (incoming().role == existing().role &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                              (incoming().role == 'owner' &&
                               getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == memberId &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'role', 'updatedAt']))
                            ))
                         );

        allow delete: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(memberId) &&
                         (
                           (isFamilyOwner(familyId) && memberId != familyDoc(familyId).ownerUid) ||
                           (isFamilyOwner(familyId) && memberId == request.auth.uid && familyDoc(familyId).memberUids.size() <= 1) ||
                           (request.auth.uid == memberId && isFamilyMember(familyId) && familyDoc(familyId).memberUids.size() > 1)
                         );
      }

      // 4. QR Join Requests (owner approval flow)
      match /joinRequests/{requesterUid} {
        allow list: if isSignedIn() &&
                       (existing().familyOwnerUid == request.auth.uid || existing().requesterUid == request.auth.uid);
        allow get: if isSignedIn() && isValidId(familyId) && isValidId(requesterUid) &&
                      (request.auth.uid == requesterUid || existing().familyOwnerUid == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(requesterUid) &&
                         request.auth.uid == requesterUid &&
                         incoming().keys().hasAll(['familyId', 'familyOwnerUid', 'requesterUid', 'requesterName', 'requesterEmail', 'inviteCode', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['familyId', 'familyOwnerUid', 'requesterUid', 'requesterName', 'requesterEmail', 'inviteCode', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().familyId == familyId &&
                         incoming().requesterUid == requesterUid &&
                         incoming().status == 'pending' &&
                         isValidJoinRequest(incoming()) &&
                         familyExists(familyId) &&
                         familyDoc(familyId).get('calendarType', 'shared') != 'personal' &&
                         familyDoc(familyId).ownerUid == incoming().familyOwnerUid &&
                         familyDoc(familyId).inviteCode == incoming().inviteCode &&
                         !(request.auth.uid in familyDoc(familyId).memberUids);

        allow update: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(requesterUid) &&
                         isValidJoinRequest(incoming()) &&
                         incoming().familyId == existing().familyId &&
                         incoming().familyOwnerUid == existing().familyOwnerUid &&
                         incoming().requesterUid == existing().requesterUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (existing().familyOwnerUid == request.auth.uid &&
                            existing().status == 'pending' &&
                            (incoming().status == 'approved' || incoming().status == 'rejected') &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                           (request.auth.uid == requesterUid &&
                            existing().status == 'rejected' &&
                            incoming().status == 'pending' &&
                            familyExists(familyId) &&
                            familyDoc(familyId).inviteCode == incoming().inviteCode &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['requesterName', 'requesterEmail', 'inviteCode', 'status', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(familyId) && isValidId(requesterUid) &&
                         (request.auth.uid == requesterUid || existing().familyOwnerUid == request.auth.uid);
      }

      // 5. Shared Family Calendar Events
      match /events/{eventId} {
        allow list: if isSignedIn() && request.auth.uid in existing().memberUids;
        allow get: if isSignedIn() && isValidId(familyId) && isValidId(eventId) &&
                      request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(eventId) &&
                         incoming().keys().hasAll(['familyId', 'title', 'description', 'location', 'dateKey', 'startMinutes', 'endMinutes', 'isAllDay', 'assignedMemberUid', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['familyId', 'title', 'description', 'location', 'dateKey', 'startMinutes', 'endMinutes', 'isAllDay', 'assignedMemberUid', 'reminderMinutesBefore', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().familyId == familyId &&
                         incoming().createdByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         isValidCalendarEvent(incoming()) &&
                         isFamilyMember(familyId);

        allow update: if isSignedIn() &&
                         isValidId(familyId) &&
                         isValidId(eventId) &&
                         isValidCalendarEvent(incoming()) &&
                         incoming().familyId == existing().familyId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (request.auth.uid in existing().memberUids &&
                            isFamilyMember(familyId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'dateKey', 'startMinutes', 'endMinutes', 'isAllDay', 'assignedMemberUid', 'reminderMinutesBefore', 'updatedAt'])) ||
                           (isFamilyOwner(familyId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                           (request.auth.uid in existing().memberUids &&
                            isFamilyMember(familyId) &&
                            !(request.auth.uid in incoming().memberUids) &&
                            existing().memberUids.hasAll(incoming().memberUids) &&
                            incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(familyId) && isValidId(eventId) &&
                         request.auth.uid in existing().memberUids &&
                         isFamilyMember(familyId);
      }
    }
  }
}
